# ============================================
# Meme AI Analyze - Environment Variables
# ============================================
# Copy this file to .env and fill in your values

# ---- Chain ----
# BSC RPC URL (Testnet for development)
BSC_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545
BSC_CHAIN_ID=97
# Mainnet (production only)
# BSC_RPC_URL=https://bsc-dataseed1.binance.org
# BSC_CHAIN_ID=56

# ---- Contract ----
# RiskReportOracle contract address (after deployment)
ORACLE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
# Oracle private key (for signing report submissions, WITHOUT 0x prefix)
ORACLE_PRIVATE_KEY=

# ---- Database ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=memeai
POSTGRES_PASSWORD=memeai_dev
POSTGRES_DB=meme_ai_analyze
DATABASE_URL=postgres://memeai:memeai_dev@localhost:5432/meme_ai_analyze?sslmode=disable

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---- AI ----
# OpenAI API
OPENAI_API_KEY=sk-
OPENAI_MODEL=gpt-4o
# Alternative: Google Gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-pro

# ---- Server ----
API_HOST=0.0.0.0
API_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---- IPFS / Arweave (optional) ----
# ARWEAVE_KEYFILE_PATH=

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080
NEXT_PUBLIC_CHAIN_ID=97
